# Copy to .env.local for local development (`vercel dev` runs /api functions).
# Every variable is required; nothing falls back to a hardcoded value.

# --- Browser (bundled into the client; public by design) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# --- Server only (Vercel functions under /api; never prefix with VITE_) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ADMIN_PASSWORD=<strong-unique-password>
# At least 32 characters, random, and unrelated to ADMIN_PASSWORD.
# Generate with: openssl rand -base64 48
SESSION_SECRET=<random-secret>
